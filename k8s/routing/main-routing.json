[
    {
        "apiVersion": "gateway.networking.k8s.io/v1",
        "kind": "Gateway",
        "metadata": {
            "name": "main-gateway",
            "namespace": "kube-system"
        },
        "spec": {
            "gatewayClassName": "traefik",
            "listeners": [
                {
                    "name": "http",
                    "protocol": "HTTP",
                    "port": 80,
                    "allowedRoutes": {
                        "namespaces": {
                            "from": "All"
                        }
                    }
                }
            ]
        }
    },
    {
        "apiVersion": "gateway.networking.k8s.io/v1",
        "kind": "HTTPRoute",
        "metadata": {
            "name": "jellyfin-route",
            "namespace": "archie"
        },
        "spec": {
            "parentRefs": [
                {
                    "name": "main-gateway",
		    "namespace": "kube-system"
                }
            ],
            "hostnames": [ "jellyfin.lmsvr.net" ],
            "rules": [
                {
                    "backendRefs": [
                        {
                            "name": "jellyfin-longhorn",
                            "port": 1997
                        }
                    ]
                }
            ]
        }
    },
    {
        "apiVersion": "gateway.networking.k8s.io/v1",
        "kind": "HTTPRoute",
        "metadata": {
            "name": "archie-web-route",
            "namespace": "archie"
        },
        "spec": {
            "parentRefs": [ 
                {
                    "name": "main-gateway",
		    "namespace": "kube-system"
                }
            ],
            "hostnames": [ "lmsvr.net" ],
            "rules": [
                {
                    "backendRefs": [
                        {
                            "name": "archie-svr",
                            "port": 4949
                        }
                    ]
                }
            ]
        }
    } 
]
