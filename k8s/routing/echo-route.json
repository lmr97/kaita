{
    "apiVersion": "gateway.networking.k8s.io/v1",
    "kind": "HTTPRoute",
    "metadata": {
        "name": "echo-route",
        "namespace": "kube-system"
    },
    "spec": {
        "parentRefs": [
            {
                "name": "traefik-gateway",
                "kind": "Gateway",
                "namespace": "kube-system",
                "sectionName": "web"
            }
        ],
        "hostnames": [
            "lmsvr.net"
        ],
        "rules": [
            {
                "backendRefs": [
                    {
                        "name": "echo-svr",
                        "kind": "Service",
                        "port": 8080,
                        "namespace": "kube-system"
                    }
                ]
            }
        ]
    }
}
