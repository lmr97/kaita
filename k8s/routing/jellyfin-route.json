			{
				"name": "traefik-gateway",
				"namespace": "kube-system"
			}
		],
		"hostnames": [
			"jellyfin.lmrsvr.net"
    ],
        "rules": [
            {
                "backendRefs": [
                    {
                        "name": "jellyfin-longhorn",
                        "namespace": "archie",
